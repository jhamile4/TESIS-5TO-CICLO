# Copia este archivo como .env y completa los valores. Nunca subas el .env a GitHub.

# Servidor
PORT=3001
NODE_ENV=development
# Dominios de los frontends que pueden usar la API, separados por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# URL del panel (se usa para volver después de conectar Facebook/Instagram)
PANEL_URL=http://localhost:5174

# Base de datos PostgreSQL (Supabase → Project Settings → Database → Connection pooler)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Supabase Storage (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Autenticación: texto largo y aleatorio, distinto en cada entorno
JWT_SECRET=

# Correo (Gmail con "contraseña de aplicación")
EMAIL_USER=
EMAIL_PASS=

# Pagos con Stripe (en la demo, claves de modo prueba: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# IA (chatbot y marketing)
GROQ_API_KEY=

# Publicación en Facebook / Instagram (opcional)
META_APP_ID=
META_APP_SECRET=

# Solo para seed.js: contraseña de las cuentas de dueño de ejemplo
SEED_PASSWORD=
